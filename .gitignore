# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# liner-app/src/features/local-music used to match local-* and was silently
# never committed — an environment reset then wiped the only copy (Task 26).
!liner-app/src/features/local-music/
!liner-app/src/features/local-music/**
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
# ...but never the transactional-mailer admin test route (real source code)
!src/app/api/moderation/email/test/
prompt

server.log
# Skills directory
/skills/

# secrets & runtime data — never commit (GitHub push protection)
/upload/
/db/custom.db
/discord-bot/alfredo.py
/discord-bot/__pycache__/
/discord-bot/bot.pid
/discord-bot/bot_data.json
/discord-bot/bot_status.json
/download/
/.zscripts/
/mini-services/
/discord-bot/
/tool-results/
/worklog.md
/.secrets/

# local SMTP catcher captures (test artifacts)
scripts/email-captures/
.env

# local git credential store (PAT) — never commit
.git-credentials
