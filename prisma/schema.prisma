generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user-created playlist holding an ordered list of saved tracks
model Playlist {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tracks    PlaylistTrack[]
}

// Ordered track rows inside a playlist (denormalized track snapshot)
model PlaylistTrack {
  id         String   @id @default(cuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  trackId    String
  source     String   @default("audius")
  title      String
  artist     String
  artistId   String?
  artwork    String?
  duration   Int      @default(0)
  position   Int
  createdAt  DateTime @default(now())

  @@index([playlistId])
}

// Liked songs collection (single-user local library)
model LikedTrack {
  id        String   @id @default(cuid())
  trackId   String   @unique
  source    String   @default("audius")
  title     String
  artist    String
  artistId  String?
  artwork   String?
  duration  Int      @default(0)
  createdAt DateTime @default(now())
}

// Recently played feed
model PlayHistory {
  id       String   @id @default(cuid())
  trackId  String
  source   String   @default("audius")
  title    String
  artist   String
  artistId String?
  artwork  String?
  duration Int      @default(0)
  username String?
  playedAt DateTime @default(now())

  @@index([playedAt])
  @@index([username])
}

// Website-port global announcement (broadcast by the site owner only).
// Goes live at showAt (= createdAt + the 10-second broadcast delay), stays
// visible for 60 seconds from showAt; clients poll for the latest live row.
model Announcement {
  id              String   @id @default(cuid())
  message         String
  senderUsername  String
  senderName      String
  senderAvatarUrl String?
  createdAt       DateTime @default(now())
  showAt          DateTime @default(now())

  @@index([showAt])
  @@index([createdAt])
}

// Website-port moderation: a ban applied to a Liner account on this website
// only (the upstream Liner API is untouched). type "normal" blocks the
// account; type "ip" additionally blocks the account's known network
// addresses site-wide. expiresAt null = forever.
model Ban {
  id        String    @id @default(cuid())
  username  String    @unique
  type      String    @default("normal")
  reason    String?
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}

// Best-effort map of which network address was last seen for which account,
// collected from the public ban-check probe so an "ip" ban can freeze the
// account's known IPs at ban time.
model IpSeen {
  ip        String   @id
  username  String
  updatedAt DateTime @updatedAt

  @@index([username])
}

// Frozen network addresses banned site-wide (snapshot taken when an "ip"
// ban is created, plus any new address the banned account shows up from).
model BanIp {
  ip        String   @id
  username  String
  createdAt DateTime @default(now())

  @@index([username])
}

// Website-port User Finder (site owner only): best-effort profile cache for
// every account that has ever opened the website while signed in. Populated
// from the verified ban-check probe (the client's own access token proves the
// identity — the upstream /v1/me answer is cached verbatim).
model UserSeen {
  username    String   @id
  email       String?
  userId      String?
  displayName String?
  avatarUrl   String?
  bio         String?
  accountCreatedAt DateTime?
  raw         String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt

  @@index([lastSeenAt])
}

// Small server-side key/value store for secrets that must survive
// republishes (the sqlite db file outlives .next rebuilds). Holds the HMAC
// key that signs the website admin gate cookie.
model SystemKey {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
